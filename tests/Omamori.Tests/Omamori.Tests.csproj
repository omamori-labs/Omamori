<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ReferenceLazer>true</ReferenceLazer>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Omamori.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LazerPath" Value="$(LazerPath)" />
  </ItemGroup>

  <ItemGroup>
    <OmamoriOwnCopy Include="nunit.framework" />
    <OmamoriOwnCopy Include="nunit.framework.legacy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Verify.NUnit" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Omamori.API\Omamori.API.csproj" />
    <ProjectReference Include="..\..\src\Omamori.Core\Omamori.Core.csproj" />
    <ProjectReference Include="..\..\src\Omamori.Bootstrap\Omamori.Bootstrap.csproj" />
    <ProjectReference Include="..\..\src\Omamori.ModBuildConfig\Omamori.ModBuildConfig.csproj" Aliases="buildconfig" />
  </ItemGroup>
</Project>
