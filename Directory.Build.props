<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <LazerPath Condition="'$(LazerPath)' == ''">$(MSBuildThisFileDirectory)sandbox\lazer</LazerPath>
  </PropertyGroup>

  <!-- shows in every assembly's file properties and in any package built from here, like the api for mod authors -->
  <PropertyGroup>
    <Product>Omamori</Product>
    <Authors>catforgor</Authors>
    <Copyright>Copyright (c) 2026 catforgor</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/catforgor/Omamori</PackageProjectUrl>
    <RepositoryUrl>https://github.com/catforgor/Omamori</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeAnalysis\BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup Condition="'$(ReferenceLazer)' == 'true'">
    <Reference Include="osu.Game" HintPath="$(LazerPath)\osu.Game.dll" Private="false" />
    <Reference Include="osu.Framework" HintPath="$(LazerPath)\osu.Framework.dll" Private="false" />
    <Reference Include="osuTK" HintPath="$(LazerPath)\osuTK.dll" Private="false" />
    <!-- generates dependency injection code for partial drawables instead of the framework falling back to reflection, compile-time only -->
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" PrivateAssets="all" />
  </ItemGroup>
</Project>
