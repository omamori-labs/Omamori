<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <LazerPath Condition="'$(LazerPath)' == ''">$(MSBuildThisFileDirectory)sandbox\lazer</LazerPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReferenceLazer)' == 'true'">
    <Reference Include="osu.Game" HintPath="$(LazerPath)\osu.Game.dll" Private="false" />
    <Reference Include="osu.Framework" HintPath="$(LazerPath)\osu.Framework.dll" Private="false" />
    <Reference Include="osuTK" HintPath="$(LazerPath)\osuTK.dll" Private="false" />
  </ItemGroup>
</Project>
