{
  "$schema": "https://json.schemastore.org/template.json",
  "author": "catforgor",
  "classifications": ["osu!", "Omamori", "Mod"],
  "identity": "Omamori.Mod.CSharp",
  "name": "Omamori mod",
  "description": "An osu!lazer mod for Omamori, with mod.json and a main menu example.",
  "shortName": "omamori-mod",
  "sourceName": "OmamoriMod",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "string",
      "description": "The mod's id: lowercase letters and digits in segments joined by . - or _, like yourname.coolmod. Defaults to yourname. and the project name in lowercase."
    },
    "nameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      }
    },
    "defaultModId": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "yourname" },
          { "type": "ref", "value": "nameLower" }
        ],
        "separator": "."
      }
    },
    "finalModId": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "defaultModId"
      },
      "replaces": "yourname.mymod"
    },
    "modAuthor": {
      "type": "parameter",
      "datatype": "string",
      "description": "Shown to users next to the mod's name.",
      "defaultValue": "you",
      "replaces": "MOD_AUTHOR"
    }
  }
}
