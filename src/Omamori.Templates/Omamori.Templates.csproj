<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <Description>dotnet new templates for Omamori mods for osu!lazer.</Description>
    <PackageTags>osu osu!lazer omamori mod template</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_OmamoriPackTemplates</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <UsingTask TaskName="_OmamoriFillTemplate" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <OmamoriVersion ParameterType="System.String" Required="true" />
      <ApiVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = File.ReadAllText(Source).Replace("__OMAMORI_VERSION__", OmamoriVersion);
        text = Regex.Replace(text, "(?<=\"apiVersion\":\\s*\")[^\"]*", ApiVersion);

        Directory.CreateDirectory(Path.GetDirectoryName(Destination));

        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
            File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_OmamoriPackTemplates" DependsOnTargets="MinVer">
    <PropertyGroup>
      <_OmamoriApiVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\src\Omamori.API\ApiInfo.cs')), 'VERSION = "([^"]+)"').Groups[1].Value)</_OmamoriApiVersion>
      <_OmamoriTemplateOut>$(IntermediateOutputPath)templates\</_OmamoriTemplateOut>
    </PropertyGroup>

    <Error Condition="'$(_OmamoriApiVersion)' == ''" Text="couldn't read ApiInfo.VERSION from src/Omamori.API/ApiInfo.cs" />

    <ItemGroup>
      <_OmamoriTemplateFile Include="content\**\*" />
      <_OmamoriTemplateText Include="@(_OmamoriTemplateFile)" Condition="'%(Extension)' == '.cs' or '%(Extension)' == '.json' or '%(Extension)' == '.csproj'" />
      <_OmamoriTemplateOther Include="@(_OmamoriTemplateFile)" Exclude="@(_OmamoriTemplateText)" />
    </ItemGroup>

    <_OmamoriFillTemplate Source="%(_OmamoriTemplateText.FullPath)"
                          Destination="$(_OmamoriTemplateOut)%(_OmamoriTemplateText.RecursiveDir)%(_OmamoriTemplateText.Filename)%(_OmamoriTemplateText.Extension)"
                          OmamoriVersion="$(PackageVersion)"
                          ApiVersion="$(_OmamoriApiVersion)" />

    <Copy SourceFiles="@(_OmamoriTemplateOther)" DestinationFiles="@(_OmamoriTemplateOther->'$(_OmamoriTemplateOut)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_OmamoriTemplateOut)**\*" PackagePath="content\%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>
