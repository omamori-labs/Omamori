<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ReferenceLazer>true</ReferenceLazer>
    <RootNamespace>Omamori.Core</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OmamoriStageDir>omamori\core</OmamoriStageDir>
    <!-- lazer runs on coreclr -->
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="Semver" />
    <PackageReference Include="Microsoft.Extensions.Primitives" ExcludeAssets="all" />
    <Reference Include="Microsoft.Extensions.Primitives" HintPath="$(LazerPath)\Microsoft.Extensions.Primitives.dll" Private="false" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="osu.Game;osu.Framework" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="osu.Framework:osu.Framework.Graphics.Containers.CompositeDrawable.AddInternal" />
    <Publicize Include="osu.Game:osu.Game.OsuGame.LoadComplete" />
    <Publicize Include="osu.Game:osu.Game.Screens.Menu.MainMenu.LoadComplete" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omamori.API\Omamori.API.csproj" />
  </ItemGroup>
</Project>
