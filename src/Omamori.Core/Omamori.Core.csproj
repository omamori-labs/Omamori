<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ReferenceLazer>true</ReferenceLazer>
    <RootNamespace>Omamori.Core</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OmamoriStageDir>omamori\core</OmamoriStageDir>
    <!-- ships LICENSE and THIRD-PARTY-NOTICES.md next to the bundled libraries -->
    <OmamoriStageNotices>true</OmamoriStageNotices>
    <OmamoriRecordLazerBuild>true</OmamoriRecordLazerBuild>
    <!-- lazer runs on coreclr -->
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="Semver" />
    <PackageReference Include="QuikGraph" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="McMaster.NETCore.Plugins" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="osu.Game;osu.Framework" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="osu.Framework:osu.Framework.Graphics.Containers.CompositeDrawable.AddInternal" />
    <Publicize Include="osu.Framework:osu.Framework.Graphics.Containers.CompositeDrawable.RemoveInternal" />
    <Publicize Include="osu.Game:osu.Game.OsuGame.LoadComplete" />
    <Publicize Include="osu.Framework:osu.Framework.Platform.GameHost.PerformExit" />
    <Publicize Include="osu.Game:osu.Game.Screens.Menu.MainMenu.LoadComplete" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\mod.schema.json" LogicalName="Omamori.Core.mod.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Omamori.Tests" />
  </ItemGroup>

  <!-- library events subscribe to lazer's database, realm ships with the game -->
  <ItemGroup>
    <Reference Include="Realm" HintPath="$(LazerPath)\Realm.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omamori.API\Omamori.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Omamori.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
