<Project>
  <PropertyGroup>
    <OmamoriStageRoot>$(MSBuildThisFileDirectory)artifacts\stage\$(Configuration)\</OmamoriStageRoot>
  </PropertyGroup>

  <Target Name="OmamoriPreferGameAssemblies" AfterTargets="ResolvePackageAssets" Condition="'$(ReferenceLazer)' == 'true'">
    <PropertyGroup>
      <_OmamoriOwnCopy>;@(OmamoriOwnCopy);</_OmamoriOwnCopy>
    </PropertyGroup>
    <ItemGroup>
      <_OmamoriGameCompile Include="@(ResolvedCompileFileDefinitions)" Condition="Exists('$(LazerPath)\%(Filename)%(Extension)') and !$(_OmamoriOwnCopy.Contains(';%(Filename);'))" />
      <ResolvedCompileFileDefinitions Remove="@(_OmamoriGameCompile)" />
      <_OmamoriGameAssembly Include="%(_OmamoriGameCompile.Filename)%(_OmamoriGameCompile.Extension)" />
      <Reference Include="@(_OmamoriGameAssembly->'$(LazerPath)\%(Identity)')" Private="false" />

      <_OmamoriGameRuntime Include="@(RuntimeCopyLocalItems)" Condition="Exists('$(LazerPath)\%(Filename)%(Extension)') and !$(_OmamoriOwnCopy.Contains(';%(Filename);'))" />
      <RuntimeCopyLocalItems Remove="@(_OmamoriGameRuntime)" />
    </ItemGroup>

    <Message Importance="normal" Condition="'@(_OmamoriGameAssembly)' != ''" Text="$(MSBuildProjectName) using the game's @(_OmamoriGameAssembly, ', ') instead of nuget's" />
  </Target>

  <Target Name="OmamoriRecordLazerBuild" BeforeTargets="GetAssemblyAttributes" Condition="'$(OmamoriRecordLazerBuild)' == 'true'">
    <XmlPeek XmlInputPath="$(LazerPath)\sq.version" Query="/n:package/n:metadata/n:version/text()"
             Namespaces="&lt;Namespace Prefix='n' Uri='http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd' /&gt;"
             Condition="Exists('$(LazerPath)\sq.version')">
      <Output TaskParameter="Result" PropertyName="_OmamoriLazerBuild" />
    </XmlPeek>

    <Warning Condition="'$(_OmamoriLazerBuild)' == ''" Text="$(LazerPath)\sq.version is missing, $(MSBuildProjectName) won't know which lazer it was built for" />

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LazerBuild</_Parameter1>
        <_Parameter2>$(_OmamoriLazerBuild)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="OmamoriStage" AfterTargets="Build" Condition="'$(OmamoriStageDir)' != ''">
    <PropertyGroup>
      <_OmamoriStageTarget>$(OmamoriStageRoot)$(OmamoriStageDir)\</_OmamoriStageTarget>
    </PropertyGroup>

    <ItemGroup>
      <_OmamoriOutput Include="$(OutDir)*.dll;$(OutDir)*.pdb" />
      <_OmamoriGameProvided Include="@(_OmamoriOutput)" Condition="Exists('$(LazerPath)\%(Filename)%(Extension)')" />
      <_OmamoriShipped Include="@(_OmamoriOutput)" Exclude="@(_OmamoriGameProvided)" />
    </ItemGroup>

    <Error Condition="'@(_OmamoriShipped)' == ''" Text="Nothing to stage for $(MSBuildProjectName) from $(OutDir)." />

    <!-- every third-party dll that ships needs its license in THIRD-PARTY-NOTICES.md, so a new dependency can't ship without one -->
    <PropertyGroup Condition="'$(OmamoriStageNotices)' == 'true'">
      <_OmamoriNoticesFile>$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md</_OmamoriNoticesFile>
      <_OmamoriNotices>$([System.IO.File]::ReadAllText('$(_OmamoriNoticesFile)'))</_OmamoriNotices>
    </PropertyGroup>
    <ItemGroup Condition="'$(OmamoriStageNotices)' == 'true'">
      <_OmamoriThirdParty Include="@(_OmamoriShipped)" Condition="'%(Extension)' == '.dll' and !$([System.String]::Copy('%(Filename)').StartsWith('Omamori.')) and !$([System.String]::Copy('%(Filename)').StartsWith('osu.Game.Rulesets.Omamori'))" />
      <_OmamoriShipped Include="$(MSBuildThisFileDirectory)LICENSE;$(_OmamoriNoticesFile)" />
    </ItemGroup>
    <Error Condition="'$(OmamoriStageNotices)' == 'true' and '%(_OmamoriThirdParty.Identity)' != '' and !$(_OmamoriNotices.Contains('%(_OmamoriThirdParty.Filename)'))"
           Text="%(_OmamoriThirdParty.Filename)%(_OmamoriThirdParty.Extension) ships in $(OmamoriStageDir) but isn't in THIRD-PARTY-NOTICES.md, add its license there." />

    <RemoveDir Directories="$(_OmamoriStageTarget)" />
    <Copy SourceFiles="@(_OmamoriShipped)" DestinationFolder="$(_OmamoriStageTarget)" />

    <Message Importance="high" Text="$(MSBuildProjectName) staged @(_OmamoriShipped->'%(Filename)%(Extension)', ', ') -> $(_OmamoriStageTarget)" />
    <Message Importance="high" Condition="'@(_OmamoriGameProvided)' != ''" Text="$(MSBuildProjectName) not shipping game-provided @(_OmamoriGameProvided->'%(Filename)%(Extension)', ', ')" />
  </Target>
</Project>
