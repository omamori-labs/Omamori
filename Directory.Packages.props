    <PackageVersion Include="JsonSchema.Net" Version="9.5.0" />
    <PackageVersion Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.2" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.0" />
