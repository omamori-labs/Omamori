<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Lib.Harmony" Version="2.4.3" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="QuikGraph" Version="2.5.0" />
    <!-- 9.x ship under an open source maintenance fee agreement -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
    <PackageVersion Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.2" />
    <PackageVersion Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- 32.0.1 is the last MIT release with no fee -->
    <PackageVersion Include="Verify.NUnit" Version="32.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.NUnit" Version="0.13.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Cake.Frosting" Version="6.3.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
